    "size": "node scripts/bundle-size.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "motion": "14.13.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
